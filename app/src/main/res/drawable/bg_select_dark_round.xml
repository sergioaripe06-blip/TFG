<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/surface_dark_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/primary_green_bright" />
        </shape>
    </item>

    <item
        android:width="34dp"
        android:top="1dp"
        android:bottom="1dp"
        android:end="1dp"
        android:gravity="end|fill_vertical">
        <shape android:shape="rectangle">
            <corners
                android:topRightRadius="16dp"
                android:bottomRightRadius="16dp" />
            <solid android:color="@color/bg_deep_green_3" />
        </shape>
    </item>

    <item
        android:width="12dp"
        android:height="12dp"
        android:end="10dp"
        android:gravity="end|center_vertical"
        android:drawable="@drawable/ic_select_chevron_down" />
</layer-list>

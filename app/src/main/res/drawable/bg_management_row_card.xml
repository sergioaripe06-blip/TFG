<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:top="8dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#14B79AD9" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/surface_chip"
                android:centerColor="@color/surface_dark"
                android:endColor="@color/surface_dark_alt" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.1dp"
                android:color="@color/divider_soft" />
        </shape>
    </item>
</layer-list>

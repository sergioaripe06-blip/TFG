<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="18dp">

        <LinearLayout
            android:id="@+id/workspaceHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group_row"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/titleTabsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/workspaceTitleTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Selecciona un piso"
                    android:textColor="@color/text_light"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/tabRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/gastosTabBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:background="@drawable/bg_tab_selected"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="42dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Movimientos"
                        android:textAllCaps="false"
                        android:textColor="@color/text_light"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/remindersTabBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:background="@drawable/bg_tab_default"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="42dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Recordatorios"
                        android:textAllCaps="false"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/tenantsTabBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:background="@drawable/bg_tab_default"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="42dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="0dp"
                        android:text="Gesti&#243;n"
                        android:textAllCaps="false"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/workspaceMetaTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Entra desde la pesta&#241;a de pisos para ver gastos, pagos y recordatorios."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/roomSelectorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Habitaci&#243;n:"
                    android:textColor="@color/text_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/roomFilterSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_select_dark_round"
                        android:paddingHorizontal="12dp"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expensesToolsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar gasto o pago:"
                android:textColor="@color/text_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/expensesSearchEt"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_dark_round"
                    android:hint="Escribe para filtrar"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_light"
                    android:textColorHint="@color/text_muted" />

                <Button
                    android:id="@+id/openFiltersBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_default"
                    android:gravity="center"
                    android:minHeight="42dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="Filtros"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light" />
            </LinearLayout>
        </LinearLayout>

        <ListView
            android:id="@+id/expensesLv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="24dp" />

        <ListView
            android:id="@+id/saldosLv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/remindersLv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/tenantsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/workspaceCtaLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Button
            android:id="@+id/addExpenseCenterFab"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:contentDescription="Acci&#243;n principal"
            android:background="@drawable/bg_button_pill_primary"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp"
            android:text="Nueva acción"
            android:textAllCaps="false"
            android:textColor="@color/on_primary_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/addMainLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nueva acción"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/quickBalancesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/quickBalancesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

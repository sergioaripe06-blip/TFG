<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="18dp">

        <LinearLayout
            android:id="@+id/workspaceHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group_row"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/workspaceTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona un piso"
                android:textColor="@color/text_light"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/workspaceMetaTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Entra desde la pestaña de pisos para ver gastos, saldos y fotos."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/gastosTabBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_selected"
                    android:text="Gastos"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light" />

                <Button
                    android:id="@+id/saldosTabBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_default"
                    android:text="Saldos"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted" />

                <Button
                    android:id="@+id/balancesTabBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_default"
                    android:text="Balances"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted" />

                <Button
                    android:id="@+id/fotosTabBtn"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_default"
                    android:text="Fotos"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <ListView
            android:id="@+id/expensesLv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="110dp" />

        <ListView
            android:id="@+id/saldosLv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="110dp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/balancesLv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="110dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/photosEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_group_row"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empieza a compartir"
                android:textColor="@color/text_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Sube una foto del piso o de un gasto para completar el espacio."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/workspaceCtaLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="98dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addExpenseCenterFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Accion principal"
            app:backgroundTint="@color/primary_green"
            app:srcCompat="@android:drawable/ic_input_add"
            app:tint="@color/on_primary_green" />

        <TextView
            android:id="@+id/addMainLabelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nuevo gasto"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <Spinner
            android:id="@+id/memberSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_select_dark_round"
            android:paddingHorizontal="10dp"
            android:popupBackground="@drawable/bg_spinner_popup" />

        <TextView
            android:id="@+id/memberFixedTv"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_select_dark_round"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:text="Persona"
            android:textColor="@color/text_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Importe (EUR):"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/memberAmountEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_dark_round"
            android:hint="Ejemplo: 50.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted" />
    </LinearLayout>

</LinearLayout>



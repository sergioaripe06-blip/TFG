<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/calendarTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calendar_title"
        android:textColor="@color/text_light"
        android:textSize="22sp"
        android:textStyle="bold" />

    <CalendarView
        android:id="@+id/paymentsCalendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_dark_round"
        android:dateTextAppearance="@style/TextAppearance.FlatShare.CalendarDate"
        android:weekDayTextAppearance="@style/TextAppearance.FlatShare.CalendarWeekday"
        android:showWeekNumber="false" />

    <TextView
        android:id="@+id/calendarSelectedDateTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/calendarEventsLv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp" />

</LinearLayout>

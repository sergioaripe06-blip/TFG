<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group_row"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/roomsTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Habitaciones"
                android:textColor="@color/text_light"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/roomsSubtitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Crea habitaciones y asigna residentes al piso."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/shareCodeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Código: ----"
                android:textColor="@color/text_light"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/inviteCodeBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_default"
                    android:text="Añadir por código"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light" />

                <Button
                    android:id="@+id/inviteEmailBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_default"
                    android:text="Añadir por email"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_group_row">

            <ListView
                android:id="@+id/roomsLv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:padding="10dp" />

            <TextView
                android:id="@+id/emptyRoomsTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Aún no hay habitaciones. Pulsa Crear habitación."
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="26dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/createRoomBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_pill_primary"
            android:text="Crear habitación"
            android:textAllCaps="false"
            android:textColor="@color/on_primary_green" />

        <Button
            android:id="@+id/finishSetupBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_pill_secondary"
            android:text="Terminar"
            android:textAllCaps="false"
            android:textColor="@color/on_primary_green" />
    </LinearLayout>

</FrameLayout>


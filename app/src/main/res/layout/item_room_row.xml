<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_tab_default"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/roomNameTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_light"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/roomMembersTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/roomCountBadgeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bottom_nav_indicator"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/on_primary_green"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoría:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/filterCategoryEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: Agua"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Persona (email):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/filterPersonEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: nombre@email.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Desde (AAAA-MM-DD):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/filterFromDateEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: 2026-01-01"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Hasta (AAAA-MM-DD):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/filterToDateEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: 2026-12-31"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

</LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Importe (EUR):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/paymentAmountEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: 45.00"
        android:inputType="numberDecimal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Concepto:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <AutoCompleteTextView
        android:id="@+id/paymentConceptEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: Pago de alquiler"
        android:inputType="textCapWords"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <Spinner
        android:id="@+id/paymentTargetTypeSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_select_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <Spinner
        android:id="@+id/paymentMemberSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_select_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <Spinner
        android:id="@+id/paymentRoomSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_select_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <Spinner
        android:id="@+id/paymentCategorySpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_select_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <TextView
        android:id="@+id/paymentCategoryFixedTv"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_select_dark_round"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_light"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Fecha (AAAA-MM-DD):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/paymentDueDateEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="@string/due_date_hint"
        android:clickable="true"
        android:focusable="false"
        android:inputType="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <Spinner
        android:id="@+id/paymentPrioritySpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_select_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

</LinearLayout>


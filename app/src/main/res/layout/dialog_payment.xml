<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/paymentAmountEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Importe"
        android:inputType="numberDecimal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <EditText
        android:id="@+id/paymentConceptEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Concepto del pago"
        android:inputType="textCapWords"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <Spinner
        android:id="@+id/paymentTargetTypeSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <Spinner
        android:id="@+id/paymentMemberSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <Spinner
        android:id="@+id/paymentRoomSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <Spinner
        android:id="@+id/paymentCategorySpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

    <EditText
        android:id="@+id/paymentDueDateEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="@string/due_date_hint"
        android:clickable="true"
        android:focusable="false"
        android:inputType="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <Spinner
        android:id="@+id/paymentPrioritySpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@color/surface_dark_alt" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Importe (EUR):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/paymentAmountEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: 45.00"
        android:inputType="numberDecimal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Concepto:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <AutoCompleteTextView
        android:id="@+id/paymentConceptEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: Pago de alquiler"
        android:inputType="textCapWords"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Destino del pago:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/paymentTargetTypeSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_select_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@drawable/bg_spinner_popup" />

    <TextView
        android:id="@+id/paymentMemberLabelTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Miembro(s):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/paymentMembersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <Button
        android:id="@+id/addPaymentMemberLineBtn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tab_default"
        android:text="Añadir línea de miembro"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:visibility="gone" />

    <Button
        android:id="@+id/removePaymentMemberLineBtn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tab_default"
        android:text="Quitar línea"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:visibility="gone" />

    <TextView
        android:id="@+id/paymentRoomLabelTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Habitación(es) destino:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/paymentRoomsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <Button
        android:id="@+id/addPaymentRoomLineBtn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tab_default"
        android:text="Añadir habitación"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:visibility="gone" />

    <Button
        android:id="@+id/removePaymentRoomLineBtn"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tab_default"
        android:text="Quitar línea"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Categoría del pago:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <AutoCompleteTextView
        android:id="@+id/paymentCategoryInputEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="Ejemplo: luz"
        android:inputType="textCapWords"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:popupBackground="@drawable/bg_spinner_popup" />

    <LinearLayout
        android:id="@+id/paymentCategoryFixedContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_readonly_premium"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock_teal_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/paymentCategoryFixedTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Categoría bloqueada"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_readonly"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Fijo"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/paymentCategoryFixedHintTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/payment_category_fixed_hint"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Fecha (DD/MM/AAAA):"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/paymentDueDateEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_dark_round"
        android:hint="@string/due_date_hint"
        android:clickable="true"
        android:focusable="false"
        android:inputType="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Prioridad:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/paymentPrioritySpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_select_dark_round"
        android:paddingHorizontal="12dp"
        android:popupBackground="@drawable/bg_spinner_popup" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Justificante del pago:"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/attachTicketBtnPayment"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_tab_default"
        android:text="Adjuntar foto"
        android:textAllCaps="false"
        android:textColor="@color/text_light" />

    <TextView
        android:id="@+id/paymentProofStatusTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sin justificante adjunto"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>


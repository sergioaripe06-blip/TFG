<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/balanceTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balance personal"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/modeToggleRow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tab_default"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/personalModeBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:text="Personal"
                android:textAllCaps="false"
                android:textColor="@color/on_primary_green" />

            <Button
                android:id="@+id/groupModeBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_default"
                android:text="Grupal"
                android:textAllCaps="false"
                android:textColor="@color/text_light" />
        </LinearLayout>

        <Spinner
            android:id="@+id/groupSelectorSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_dark_round"
            android:paddingHorizontal="12dp"
            android:popupBackground="@color/surface_dark_alt"
            android:visibility="gone" />

        <com.sergio.flatshare.ui.widget.PieChartView
            android:id="@+id/personalPieChart"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_group_row"
            android:padding="12dp" />

        <LinearLayout
            android:id="@+id/personalLegendContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>

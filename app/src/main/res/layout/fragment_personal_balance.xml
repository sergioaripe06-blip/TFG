<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/balanceTitleTv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_balance_title_pill"
            android:gravity="center"
            android:text="Balance de gastos"
            android:textColor="@color/text_light"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/balanceSubtitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Resumen por categorías del piso seleccionado"
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/groupSelectorSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_select_dark_round"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_spinner_popup"
            android:visibility="visible" />

        <com.sergio.flatshare.shared.widgets.PieChartView
            android:id="@+id/personalPieChart"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_group_row"
            android:padding="18dp" />

        <LinearLayout
            android:id="@+id/personalLegendContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/monthlyChartTitleTv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_balance_title_pill"
            android:gravity="center"
            android:text="Balance por tiempo"
            android:textColor="@color/text_light"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monthlyChartSubtitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Distribucion temporal de tus movimientos (EUR)"
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/timePeriodSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_select_dark_round"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_spinner_popup" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <com.sergio.flatshare.shared.widgets.MonthlyBarChartView
                android:id="@+id/monthlyBarChart"
                android:layout_width="wrap_content"
                android:layout_height="270dp"
                android:background="@drawable/bg_group_row"
                android:padding="10dp" />
        </HorizontalScrollView>

    </LinearLayout>

</ScrollView>


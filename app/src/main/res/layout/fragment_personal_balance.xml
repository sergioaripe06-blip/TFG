<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/balanceTitleTv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_balance_title_pill"
            android:gravity="center"
            android:text="Balance"
            android:textColor="@color/text_light"
            android:textSize="34sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/groupSelectorSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_select_dark_round"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_spinner_popup"
            android:visibility="visible" />

        <com.sergio.flatshare.shared.widgets.PieChartView
            android:id="@+id/personalPieChart"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_group_row"
            android:padding="12dp" />

        <LinearLayout
            android:id="@+id/personalLegendContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/monthlyChartTitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pagado por mes"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:id="@+id/monthlyChartSubtitleTv"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Has pagado (EUR)"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.sergio.flatshare.shared.widgets.MonthlyBarChartView
            android:id="@+id/monthlyBarChart"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_group_row"
            android:padding="10dp" />

        <LinearLayout
            android:id="@+id/ownerStatsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/ownerChartTitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cobros del propietario"
                android:textColor="@color/text_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/ownerPeriodSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_select_dark_round"
                android:paddingHorizontal="12dp"
                android:popupBackground="@drawable/bg_spinner_popup" />

            <TextView
                android:id="@+id/ownerChartSubtitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pagos confirmados recibidos (EUR)"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <com.sergio.flatshare.shared.widgets.MonthlyBarChartView
                android:id="@+id/ownerPaidChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_group_row"
                android:padding="10dp" />

            <TextView
                android:id="@+id/ownerMemberDetailTitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Detalle por mes y miembro"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ownerMemberDetailContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>


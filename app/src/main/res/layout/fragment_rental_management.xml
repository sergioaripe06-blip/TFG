<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_group_row"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cobros y soporte del alquiler"
            android:textColor="@color/text_light"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/managementModuleHintTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Gestiona cobros, incidencias y documentos del piso."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/managementModuleSpinner"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_select_dark_round"
            android:paddingHorizontal="12dp"
            android:popupBackground="@drawable/bg_spinner_popup" />

        <Button
            android:id="@+id/managementPrimaryActionBtn"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_pill_primary"
            android:text="Crear"
            android:textAllCaps="false"
            android:textColor="@color/on_primary_green" />
    </LinearLayout>

    <ListView
        android:id="@+id/managementRowsLv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingTop="10dp"
        android:paddingBottom="100dp" />

    <TextView
        android:id="@+id/managementEmptyTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No hay datos todavía en este módulo."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>


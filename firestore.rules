rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInAndVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function authUid() {
      return request.auth.uid;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupOwner(groupId) {
      return groupExists(groupId) && groupDoc(groupId).data.ownerId == authUid();
    }

    function isGroupMember(groupId) {
      return groupExists(groupId) && groupDoc(groupId).data.members.hasAny([authUid()]);
    }

    function isResourceGroupMember() {
      return signedInAndVerified() && resource.data.members.hasAny([authUid()]);
    }

    function isSelfJoinUpdate() {
      return signedInAndVerified()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['members', 'memberEmails', 'roles'])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.hasAny([authUid()])
        && request.resource.data.memberEmails.size() == resource.data.memberEmails.size() + 1
        && request.resource.data.memberEmails.hasAll(resource.data.memberEmails)
        && request.resource.data.memberEmails.hasAny([authEmail()])
        && request.resource.data.roles.size() == resource.data.roles.size() + 1
        && request.resource.data.roles.keys().hasAll(resource.data.roles.keys())
        && request.resource.data.roles[authUid()] == 'member';
    }

    function isSelfLeaveUpdate() {
      return signedInAndVerified()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['members', 'memberEmails', 'roles'])
        && request.resource.data.members.size() + 1 == resource.data.members.size()
        && resource.data.members.hasAny([authUid()])
        && !request.resource.data.members.hasAny([authUid()])
        && request.resource.data.members.hasAll(resource.data.members.removeAll([authUid()]))
        && request.resource.data.memberEmails.size() + 1 == resource.data.memberEmails.size()
        && resource.data.memberEmails.hasAny([authEmail()])
        && !request.resource.data.memberEmails.hasAny([authEmail()])
        && request.resource.data.memberEmails.hasAll(resource.data.memberEmails.removeAll([authEmail()]))
        && !request.resource.data.roles.keys().hasAny([authUid()])
        && request.resource.data.roles.keys().hasAll(resource.data.roles.keys().removeAll([authUid()]));
    }

    function roomIsEmpty() {
      return resource.data.memberCount == 0
        && resource.data.memberEmails.size() == 0;
    }

    function isPaymentStatusToggleByOwner() {
      return signedInAndVerified()
        && isGroupOwner(resource.data.groupId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['requested', 'pending', 'confirmed']
        && resource.data.status in ['requested', 'pending', 'confirmed'];
    }

    function canGroupOwnerDeletePayment() {
      return signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /users/{userId} {
      allow read: if signedInAndVerified();
      allow write: if signedInAndVerified() && authUid() == userId;
    }

    match /group_codes/{code} {
      allow read: if signedInAndVerified();
      allow create, update: if signedInAndVerified()
        && request.resource.data.groupId is string
        && isGroupOwner(request.resource.data.groupId);
      allow delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /groups/{groupId} {
      allow create: if signedInAndVerified()
        && request.resource.data.ownerId == authUid()
        && request.resource.data.members.hasAny([authUid()])
        && request.resource.data.memberEmails.hasAny([authEmail()]);

      // For list/queries use resource.data directly; cross-document get() here can deny valid queries.
      allow read: if isResourceGroupMember();

      allow update: if signedInAndVerified() && (
        isGroupOwner(groupId) ||
        isSelfJoinUpdate() ||
        isSelfLeaveUpdate()
      );

      allow delete: if signedInAndVerified() && isGroupOwner(groupId);
    }

    match /rooms_groups/{roomId} {
      allow create: if signedInAndVerified()
        && request.resource.data.createdByUid == authUid()
        && request.resource.data.updatedByUid == authUid()
        && isGroupOwner(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);

      allow delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId)
        && roomIsEmpty();
    }

    match /expenses/{expenseId} {
      allow create: if signedInAndVerified()
        && request.resource.data.payerId == authUid()
        && isGroupMember(request.resource.data.groupId);

      allow read, update, delete: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);
    }

    match /payments/{paymentId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId)
        && (
          request.resource.data.fromEmail == authEmail()
          || (
            isGroupOwner(request.resource.data.groupId)
            && request.resource.data.seed == true
            && request.resource.data.toEmail == authEmail()
            && request.resource.data.fromEmail.matches('^seeduser[0-9]{3}@seed\\.flatshare\\.local$')
          )
        );

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update: if isPaymentStatusToggleByOwner();

      allow delete: if canGroupOwnerDeletePayment();
    }

    match /payment_deadlines/{deadlineId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId);

      allow read, update, delete: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);
    }

    match /reminders/{reminderId} {
      allow create: if signedInAndVerified()
        && request.resource.data.ownerUid == authUid()
        && isGroupMember(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update, delete: if signedInAndVerified()
        && isGroupMember(resource.data.groupId)
        && (
          resource.data.ownerUid == authUid()
          || isGroupOwner(resource.data.groupId)
        );
    }

    match /activity_logs/{logId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId);

      allow read, update, delete: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);
    }

    match /rental_contracts/{contractId} {
      allow create: if signedInAndVerified()
        && isGroupOwner(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update, delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /rent_collections/{rentId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update, delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /maintenance_tickets/{ticketId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update, delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /group_documents/{docId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update, delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /audit_events/{eventId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update: if false;
      allow delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /rent_automations/{ruleId} {
      allow create: if signedInAndVerified()
        && isGroupOwner(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update, delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /event_reminder_rules/{ruleId} {
      allow create: if signedInAndVerified()
        && isGroupOwner(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update, delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /event_reminder_jobs/{jobId} {
      allow create: if signedInAndVerified()
        && isGroupMember(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && isGroupMember(resource.data.groupId);

      allow update: if false;
      allow delete: if signedInAndVerified()
        && isGroupOwner(resource.data.groupId);
    }

    match /invitations/{invitationId} {
      allow create: if signedInAndVerified()
        && request.resource.data.inviterUid == authUid()
        && isGroupMember(request.resource.data.groupId);

      allow read: if signedInAndVerified()
        && (
          resource.data.inviterUid == authUid() ||
          resource.data.invitedEmail == authEmail() ||
          isGroupOwner(resource.data.groupId)
        );

      allow update, delete: if signedInAndVerified()
        && (
          resource.data.inviterUid == authUid() ||
          resource.data.invitedEmail == authEmail() ||
          isGroupOwner(resource.data.groupId)
        ); 
    }
  }
}

